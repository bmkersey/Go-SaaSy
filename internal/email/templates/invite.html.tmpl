<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>You’re invited to SaaSy</title>
  <style>
    body {
      background-color: #f9f9f9f9;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
      padding: 2rem;
      text-align: center;
    }
    h2{
      color: black;
    }
    p{
      color: black;
    }
    .card {
      background-color: #f9f9f9;
      border-radius: 8px;
      padding: 2rem;
      max-width: 480px;
      margin: 0 auto;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.05);
    }
    .logo {
      width: 80px;
      margin-bottom: 1rem;
    }
    .button {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: #b8b8b8;
      text-decoration: none;
      color: black;
      font-weight: bold;
      border-radius: 6px;
      margin-top: 1.5rem;
      
    }
    .footer {
      margin-top: 2rem;
      font-size: 0.8rem;
      color: #8b949e;
    }
  </style>
</head>
<body>
  <div class="card">
    <img src="https:/localhost:8080/assets/sassywhite.png" alt="SaaSy Logo" class="logo" />
    <h2>You've been invited to join SaaSy!</h2>
    <p>Click below to accept your invite and join your organization.</p>
    <a href="{{.InviteLink}}" class="button">Accept Invite</a>
  </div>
  <div class="footer">
    If you didn’t expect this email, you can safely ignore it.
  </div>
</body>
</html>
